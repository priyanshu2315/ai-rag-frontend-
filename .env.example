# Base URL of the RAG backend. Must include the /api prefix.
VITE_API_BASE_URL=http://localhost:3000/api

# Optional display-only conversion for Gemini list-price estimates.
# Keep the value, source, and date together; no exchange rate is silently assumed.
VITE_USD_INR_RATE=
VITE_USD_INR_RATE_SOURCE=
VITE_USD_INR_RATE_DATE=
